# Banco local (usado pelo Docker Compose)
POSTGRES_DB=rotina
POSTGRES_USER=rotina
POSTGRES_PASSWORD=rotina

# Perfil ativo
SPRING_PROFILES_ACTIVE=dev

# JWT: gere o seu com openssl rand -base64 48
JWT_SECRET=troque-isto-por-uma-chave-aleatoria-de-no-minimo-32-bytes

# Google OAuth
GOOGLE_CLIENT_ID=

# Origens liberadas no CORS (front local)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173